# ENV VAR for ubuntu distro
UBUNTU_DISTRO = jammy

# ENV VAR for time zone
TZ=America/Toronto

# ENV VAR for ros
ROS_VERSION=2
ROS_DISTRO=humble
ROS_PYTHON_VERSION=3

# ENV VAR for camera
CAMERA_MODEL=D435I

CAMERA_DEPTH_PROFILE=424x240x6
CAMERA_INFRA_PROFILE=424x240x6
CAMERA_COLOR_PROFILE=424x240x6

CAMERA_ACCEL=true
CAMERA_GYRO=true

# ENV VAR for port used by foxglove
ROS_FOXGLOVE_PORT=8765

